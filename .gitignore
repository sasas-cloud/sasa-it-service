# SASA-IT Service Plattform — .gitignore

# Environment and secrets
.env
.env.local
.env.production
.venv/
venv/
*.env

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/

# Node / JavaScript (falls verwendet)
node_modules/
dist/
build/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/
var/log/

# Temporary files
tmp/
temp/
.cache/
*.tmp

# OS
.DS_Store
Thumbs.db

# Secrets
*.pem
*.key
*.crt
secrets/

# Docker (optional: build artifacts)
docker/*.tar
docker/*.tar.gz
