{
    email admin@sasa-it.de
}

# ── Landing Page ──
sasa-it.de, www.sasa-it.de {
    root * /var/www/landing-page
    file_server
}

# ── Authentik SSO ──
auth.sasa-it.de {
    reverse_proxy 127.0.0.1:9000
}

# ── Nextcloud AIO ──
office.sasa-it.de {
    reverse_proxy 127.0.0.1:8080
}

# ── NetBird Dashboard ──
sso.sasa-it.de {
    reverse_proxy 127.0.0.1:3002
}

# ── Wiki.js ──
wiki.sasa-it.de {
    reverse_proxy 127.0.0.1:3001
}

# ── Grafana ──
grafana.sasa-it.de {
    reverse_proxy 127.0.0.1:3000
}

# ── Passbolt — Passwort-Manager (Tailscale: 100.104.100.4) ──
passbolt.sasa-it.de {
    tls {
        protocols tls1.2 tls1.3
    }
    reverse_proxy 100.104.100.4:443
    header {
        +Strict-Transport-Security "max-age=31536000; includeSubDomains"
        +X-Frame-Options "SAMEORIGIN"
    }
}

# ── Wazuh — Security Monitoring (Tailscale: 100.125.176.124) ──
security.sasa-it.de {
    tls {
        protocols tls1.2 tls1.3
    }
    reverse_proxy 100.125.176.124:443
    header {
        +Strict-Transport-Security "max-age=31536000; includeSubDomains"
        +X-Frame-Options "SAMEORIGIN"
    }
}
